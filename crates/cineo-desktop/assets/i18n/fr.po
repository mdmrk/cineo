#: crates/cineo-desktop/src/settings/mod.rs:212
msgid ""
"Links to addons and pages open in Cineo. Stremio stops receiving stremio:// "
"links."
msgstr ""
"Les liens vers des extensions et des pages s'ouvrent dans Cineo. Stremio ne "
"reçoit plus les liens stremio://."

#: crates/cineo-desktop/src/settings/mod.rs:220
msgid "Use Cineo"
msgstr "Utiliser Cineo"

#: crates/cineo-desktop/src/settings/mod.rs:224
