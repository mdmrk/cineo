#: crates/cineo-desktop/src/settings/mod.rs:210
msgid "Open stremio:// and cineo:// links"
msgstr "Abrir enlaces stremio:// y cineo://"

#: crates/cineo-desktop/src/settings/mod.rs:212
msgid ""
"Links to addons and pages open in Cineo. Stremio stops receiving stremio:// "
"links."
msgstr ""
"Los enlaces a add-ons y páginas se abren en Cineo. Stremio deja de recibir "
"los enlaces stremio://."

#: crates/cineo-desktop/src/settings/mod.rs:220
msgid "Use Cineo"
msgstr "Usar Cineo"

#: crates/cineo-desktop/src/settings/mod.rs:224
msgid "Done"
