msgstr "←/→ とシークボタンで移動する幅。"

#: crates/cineo-desktop/src/settings/mod.rs:317
msgid "Short seek step"
msgstr "短いシーク幅"

#: crates/cineo-desktop/src/settings/mod.rs:318
msgid "How far Shift+←/→ jump."
msgstr "Shift+←/→ で移動する幅。"

#: crates/cineo-desktop/src/settings/mod.rs:327
msgid "Hide controls after"
msgstr "コントロールを隠すまでの時間"

#: crates/cineo-desktop/src/settings/mod.rs:328
