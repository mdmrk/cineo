#: crates/cineo-desktop/src/settings/mod.rs:290
msgid "Hardware decoding"
msgstr "Decodificación por hardware"

#: crates/cineo-desktop/src/settings/mod.rs:292
msgid ""
"Lets the graphics card decode video, which saves power. Turn it off if "
"videos show artifacts or a black picture."
msgstr ""
"Deja que la tarjeta gráfica decodifique el video, lo que ahorra energía. "
"Desactívala si los videos muestran artefactos o una imagen negra."

#: crates/cineo-desktop/src/settings/mod.rs:300
msgid "Seek step"
msgstr "Salto"

#: crates/cineo-desktop/src/settings/mod.rs:301
msgid "How far ←/→ and the seek buttons jump."
msgstr "Cuánto saltan ←/→ y los botones de salto."

#: crates/cineo-desktop/src/settings/mod.rs:310
msgid "Short seek step"
msgstr "Salto corto"

#: crates/cineo-desktop/src/settings/mod.rs:311
msgid "How far Shift+←/→ jump."
msgstr "Cuánto salta Shift+←/→."

#: crates/cineo-desktop/src/settings/mod.rs:320
msgid "Hide controls after"
msgstr "Ocultar controles tras"

#: crates/cineo-desktop/src/settings/mod.rs:321
msgid "Without mouse or key input while playing."
msgstr "Sin usar el mouse ni el teclado durante la reproducción."

#: crates/cineo-desktop/src/settings/mod.rs:330
msgid "Esc leaves fullscreen first"
msgstr "Esc sale primero de pantalla completa"

#: crates/cineo-desktop/src/settings/mod.rs:331
msgid "When off, Esc leaves the player at once."
msgstr "Si está desactivado, Esc cierra el reproductor directamente."

#: crates/cineo-desktop/src/settings/mod.rs:338
msgid "Pause when minimized"
msgstr "Pausar al minimizar"

#: crates/cineo-desktop/src/settings/mod.rs:346
msgid "Remember volume"
msgstr "Recordar el volumen"

#: crates/cineo-desktop/src/settings/mod.rs:347
msgid "Each video starts at the volume the last one ended with."
msgstr "Cada video empieza con el volumen con el que terminó el anterior."

#: crates/cineo-desktop/src/settings/mod.rs:354
msgid "Play the next episode automatically"
msgstr "Reproducir el siguiente episodio automáticamente"

#: crates/cineo-desktop/src/settings/mod.rs:356
msgid ""
"When an episode ends, the next one plays from the same addon, or its streams "
"open."
msgstr ""
"Al terminar un episodio, se reproduce el siguiente del mismo add-on o se "
"abren sus fuentes."

#: crates/cineo-desktop/src/settings/mod.rs:364
msgid "Next episode notice"
msgstr "Aviso del siguiente episodio"

#: crates/cineo-desktop/src/settings/mod.rs:365
msgid "How long before the end the next episode is offered."
msgstr "Cuánto antes del final se ofrece el siguiente episodio."

#: crates/cineo-desktop/src/settings/mod.rs:376
msgid "Audio language"
msgstr "Idioma del audio"

#: crates/cineo-desktop/src/settings/mod.rs:377
msgid "The file's track in this language plays; otherwise its default track."
msgstr ""
"Se reproduce la pista del archivo en este idioma; si no hay, su pista "
"predeterminada."

#: crates/cineo-desktop/src/settings/mod.rs:384
msgid "Second audio language"
msgstr "Segundo idioma del audio"

#: crates/cineo-desktop/src/settings/mod.rs:385
msgid "Used when the file has no audio in the first."
msgstr "Se usa cuando el archivo no tiene audio en el primero."

#: crates/cineo-desktop/src/settings/mod.rs:392
msgid "Subtitle language"
msgstr "Idioma de los subtítulos"

#: crates/cineo-desktop/src/settings/mod.rs:394
msgid ""
"Turned on when a video starts: from the file if it has them, otherwise from "
"a subtitles addon."
msgstr ""
"Se activan al empezar un video: del archivo si los tiene y, si no, de un add-"
"on de subtítulos."

#: crates/cineo-desktop/src/settings/mod.rs:402
msgid "Second subtitle language"
msgstr "Segundo idioma de los subtítulos"

#: crates/cineo-desktop/src/settings/mod.rs:403
msgid "Used when no subtitle is in the first."
msgstr "Se usa cuando no hay subtítulos en el primero."

#: crates/cineo-desktop/src/settings/mod.rs:413
msgid "Audio output"
msgstr "Salida de audio"

#: crates/cineo-desktop/src/settings/mod.rs:414
msgid "Stereo mixes surround sound down to two speakers or headphones."
msgstr "Estéreo convierte el sonido envolvente a dos altavoces o auriculares."

#: crates/cineo-desktop/src/settings/mod.rs:423
msgid "Passthrough"
msgstr "Passthrough"

#: crates/cineo-desktop/src/settings/mod.rs:425
msgid ""
"Sends Dolby and DTS audio undecoded to a receiver over HDMI or S/PDIF. Leave "
"off unless your receiver decodes them, or you may hear silence."
msgstr ""
"Envía el audio Dolby y DTS sin decodificar a un receptor por HDMI o S/PDIF. "
"Déjalo desactivado salvo que tu receptor los decodifique, o puede que no "
"oigas nada."

#: crates/cineo-desktop/src/settings/mod.rs:436
msgid "Count as watched at"
msgstr "Contar como visto al"

#: crates/cineo-desktop/src/settings/mod.rs:437
msgid "Watched videos start over and leave Continue Watching."
msgstr "Los videos vistos empiezan de nuevo y salen de Seguir viendo."

#: crates/cineo-desktop/src/settings/mod.rs:445
msgid "Clear watch history"
msgstr "Borrar el historial"

#: crates/cineo-desktop/src/settings/mod.rs:446
msgid "Empties the Library and Continue Watching."
msgstr "Vacía la Biblioteca y Seguir viendo."

#: crates/cineo-desktop/src/settings/mod.rs:448
msgid "Clear…"
msgstr "Borrar…"

#: crates/cineo-desktop/src/settings/mod.rs:455
msgid "Reset all settings"
msgstr "Restablecer toda la configuración"

#: crates/cineo-desktop/src/settings/mod.rs:456
msgid "Every setting on this page goes back to its default."
msgstr "Todas las opciones de esta página vuelven a su valor predeterminado."

#: crates/cineo-desktop/src/settings/mod.rs:458
msgid "Reset…"
msgstr "Restablecer…"

#: crates/cineo-desktop/src/settings/mod.rs:472
#: crates/cineo-desktop/src/settings/mod.rs:486
msgid "Check for updates"
msgstr "Buscar actualizaciones"

#: crates/cineo-desktop/src/settings/mod.rs:473
#: crates/cineo-desktop/src/settings/mod.rs:487
msgid "Asks GitHub once per start whether a newer version exists."
msgstr "Pregunta a GitHub al iniciar si hay una versión más nueva."

#: crates/cineo-desktop/src/settings/mod.rs:479
#: crates/cineo-desktop/src/view/sidebar.rs:82
#, rust-format
msgid "Cineo v{version}"
msgstr "Cineo v{version}"

#: crates/cineo-desktop/src/settings/mod.rs:501
msgid "Cineo is free software under the MIT License."
msgstr "Cineo es software libre bajo la licencia MIT."

#: crates/cineo-desktop/src/settings/mod.rs:502
msgid "Made with Rust, egui, mpv and librqbit."
msgstr "Hecho con Rust, egui, mpv y librqbit."

#: crates/cineo-desktop/src/settings/mod.rs:521
msgid "Show and play torrent streams"
msgstr "Mostrar y reproducir transmisiones torrent"

#: crates/cineo-desktop/src/settings/mod.rs:523
#: crates/cineo-desktop/src/view/mod.rs:470
msgid ""
"Torrent streams come from other people's computers. While one plays, your IP "
"address is visible to the peers and trackers it connects to, and Cineo "
"uploads the parts it has already downloaded to those peers. Downloaded data "
"is kept in a local cache. You can turn peer-to-peer streaming off in "
"Settings."
msgstr ""
"Las transmisiones torrent vienen de las computadoras de otras personas. "
"Mientras se reproduce una, tu dirección IP es visible para los pares y "
"trackers a los que se conecta, y Cineo sube a esos pares las partes que ya "
"ha descargado. Los datos descargados se guardan en una caché local. Puedes "
"desactivar el streaming entre pares en Configuración."

#: crates/cineo-desktop/src/settings/mod.rs:531
msgid "Upload to other peers"
msgstr "Subir a otros pares"

#: crates/cineo-desktop/src/settings/mod.rs:533
msgid ""
"When off, Cineo only downloads. Some peers then send less, so torrents can "
"be slower. Your IP address is still visible to peers."
msgstr ""
"Si está desactivado, Cineo solo descarga. Algunos pares envían entonces "
"menos, así que los torrents pueden ir más lentos. Tu dirección IP sigue "
"siendo visible para los pares."

#: crates/cineo-desktop/src/settings/mod.rs:541
msgid "Torrent data"
msgstr "Datos del torrent"

#: crates/cineo-desktop/src/settings/mod.rs:543
msgid ""
"Cineo keeps only the part around the playback position, up to the size "
"chosen, in memory or on disk. Seeking back past it downloads that part "
"again. Nothing is kept as a cache: the data is deleted when playback stops. "
"Applies from the next torrent you play."
msgstr ""
"Cineo guarda solo la parte cercana a la posición de reproducción, hasta el "
"tamaño elegido, en memoria o en el disco. Retroceder más allá vuelve a "
"descargar esa parte. No se guarda ninguna caché: los datos se borran al "
"terminar la reproducción. Se aplica desde el próximo torrent que reproduzcas."

#: crates/cineo-desktop/src/settings/mod.rs:553
msgid "Download limit"
msgstr "Límite de descarga"

#: crates/cineo-desktop/src/settings/mod.rs:554
#: crates/cineo-desktop/src/settings/mod.rs:564
msgid "Applies from the next torrent you play."
msgstr "Se aplica desde el próximo torrent que reproduzcas."

#: crates/cineo-desktop/src/settings/mod.rs:563
msgid "Upload limit"
msgstr "Límite de subida"

#: crates/cineo-desktop/src/settings/mod.rs:573
msgid "Peers per torrent"
msgstr "Pares por torrent"

#: crates/cineo-desktop/src/settings/mod.rs:574
msgid "More peers can be faster but use more connections."
msgstr "Más pares puede ser más rápido, pero usa más conexiones."

#: crates/cineo-desktop/src/settings/mod.rs:583
msgid "Find peers through the DHT"
msgstr "Buscar pares mediante la DHT"

#: crates/cineo-desktop/src/settings/mod.rs:584
msgid "Finds peers without trackers. Off means fewer peers for many torrents."
msgstr ""
"Encuentra pares sin trackers. Desactivarla significa menos pares para muchos "
"torrents."

#: crates/cineo-desktop/src/settings/mod.rs:590
#: crates/cineo-desktop/src/settings/mod.rs:595
msgid "Listening port"
msgstr "Puerto de escucha"

#: crates/cineo-desktop/src/settings/mod.rs:592
msgid ""
"Peers can connect to Cineo on this port, over TCP and uTP. Forward it on "
"your router for more peers. If it is taken, a random port is used. Applies "
"from the next torrent you play."
msgstr ""
"Los pares pueden conectarse a Cineo en este puerto, por TCP y uTP. "
"Redirígelo en tu router para tener más pares. Si está ocupado, se usa uno al "
"azar. Se aplica desde el siguiente torrent que reproduzcas."

#: crates/cineo-desktop/src/settings/mod.rs:603
msgid "Allow local network addresses"
msgstr "Permitir direcciones de la red local"

#: crates/cineo-desktop/src/settings/mod.rs:605
msgid ""
"Lets addons, images and torrent peers on 127.0.0.1 or your home network be "
"reached, for self-hosted addons. Off is safer. Takes effect after restarting "
"Cineo."
msgstr ""
"Permite acceder a add-ons, imágenes y pares torrent en 127.0.0.1 o en tu red "
"doméstica, para add-ons alojados por ti. Desactivado es más seguro. Se "
"aplica al reiniciar Cineo."

